# =============================================================================
# AFI Retailer - Supabase Environment Variables
# =============================================================================
# Copy this to .env and fill in real values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Supabase Project ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OAuth Token Encryption ---
# Generate with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=your-32-byte-base64-key

# --- Meta (Facebook + Instagram) OAuth ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# --- Google (YouTube + Google Business Profile) OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Dashboard URL (for OAuth redirect) ---
DASHBOARD_URL=https://afiretailer.com/dashboard.html
